# Copy to backend/.env and fill in. Never commit .env.
# Keys stay on the backend. They are never sent to the frontend.

GROQ_API_KEY=
# Choose a current Groq model that supports tool calling / JSON output
# (see https://console.groq.com/docs/models). Not hardcoded in the app.
GROQ_MODEL=

# One key serves Google Flights, Google Hotels, and Google Maps (SerpApi).
SERPAPI_API_KEY=

GEOAPIFY_API_KEY=
OPENWEATHER_API_KEY=

# Optional, non-secret settings
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PROVIDER_TIMEOUT_SECONDS=20
# LLM_TIMEOUT_SECONDS=60
# LOG_LEVEL=INFO
